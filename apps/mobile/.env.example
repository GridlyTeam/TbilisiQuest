# Copy to apps/mobile/.env and fill in from Supabase: Project Settings > API
# EXPO_PUBLIC_ vars are embedded in the app bundle and readable by anyone who
# downloads it. That is fine for these two -- RLS is what protects the data.
# Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mapbox: account.mapbox.com > Tokens. A public pk.* token is expected here.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-public-token
