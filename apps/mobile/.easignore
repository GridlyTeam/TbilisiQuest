# Files EAS Build does not need in the project archive.
#
# Without this, the upload was 405 MB and took over a minute every build: the
# archive was picking up node_modules, which EAS reinstalls on the builder from
# package-lock.json anyway. Note that .easignore REPLACES .gitignore for this
# purpose rather than adding to it, so anything that should stay out has to be
# listed here even if git already ignores it.

node_modules/
.expo/
dist/
web-build/

# Native projects are generated by prebuild on the builder; a stale local copy
# is worse than none.
android/
ios/

# Build output and local artefacts.
*.apk
*.aab
*.keystore
*.jks

# Editor and OS noise.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Nothing on the builder reads these.
*.log
coverage/
