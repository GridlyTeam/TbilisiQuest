# Copy to apps/merchant/.env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Default timezone for composing drop schedules from local wall-clock times.
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Tbilisi
